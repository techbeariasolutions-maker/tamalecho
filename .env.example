# Solo los nombres de las variables. Los valores viven en Vercel y nunca entran al repositorio.
# Web Push (D-21). Los configura quien administra el proyecto en Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
DISPATCH_SECRET=

# La clave pública que recibe el navegador.
VITE_VAPID_PUBLIC_KEY=

# Almacén de suscripciones. Las crea la conexión de Upstash en Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
